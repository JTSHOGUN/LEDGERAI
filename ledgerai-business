function pathHasExtension(p) {
  const lastSlash = p.lastIndexOf('/');
  const lastDot = p.lastIndexOf('.');
  return lastDot > lastSlash && lastDot !== -1;
}

const server = http.createServer((req, res) => {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Requested-With, X-Callback-Signature');

  if (req.method === 'OPTIONS') {
    res.writeHead(204);
    res.end();
    return;
  }

  let reqPath = (req.url || '/').split('?')[0];

  // API Route: Health
  if (reqPath === '/health' || reqPath === '/api/health' || reqPath === '/api/ping') {
    res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
    res.end(JSON.stringify({
      status: 'healthy',
      app: 'LedgerAI Africa',
      tier: TIER_DISPLAY,
      version: '1.0.0-PROD-AFRICA',
      tagline: 'Your books, understood.',
      timestamp: new Date().toISOString(),
      uptime_seconds: Math.floor(process.uptime()),
      embedded_assets_count: Object.keys(ASSETS).length,
      real_market_ready: true,
      features: TIER_FEATURES
    }, null, 2));
    return;
  }

  // API Route: Webhooks
  if (reqPath.startsWith('/api/momo/webhook') || reqPath.startsWith('/api/airtel/webhook')) {
    let body = '';
    req.on('data', chunk => { body += chunk; });
    req.on('end', () => {
      res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
      res.end(JSON.stringify({
        status: 'received',
        gateway: reqPath.includes('momo') ? 'MTN MoMo Open API' : 'Airtel MoneyPay',
        timestamp: new Date().toISOString(),
        message: 'Callback logged into double-entry staging ledger for reconciliation.'
      }));
    });
    return;
  }

  if (reqPath === '/' || reqPath === '') {
    reqPath = '/index.html';
  }

  let asset = ASSETS[reqPath];
  if (!asset && !pathHasExtension(reqPath)) {
    asset = ASSETS['/index.html'];
  }

  if (!asset) {
    res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
    res.end('404 Not Found - LedgerAI Africa Resource: ' + reqPath);
    return;
  }

  const buffer = Buffer.from(asset.data, 'base64');
  const isHtml = asset.mimeType.startsWith('text/html');

  const headers = {
    'Content-Type': asset.mimeType,
    'Content-Length': buffer.length,
    'Cache-Control': isHtml ? 'no-cache, must-revalidate' : 'public, max-age=31536000, immutable',
    'X-Content-Type-Options': 'nosniff',
    'X-App-Tier': TIER
  };

  res.writeHead(200, headers);
  res.end(buffer);
});

